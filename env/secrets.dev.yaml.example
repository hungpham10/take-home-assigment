# Template — copy sang env/secrets.dev.env (gitignored), điền value thật rồi:
#   sops -e env/secrets.dev.env > env/secrets.dev.enc.yaml
# Key format: LTP_TENANT_<SLUG>_<SECRET> — resolver đọc theo tenant slug.

# Demo tenant (slug=acme):
LTP_TENANT_ACME_OIDC_CLIENT_SECRET=change-me-dev
LTP_TENANT_ACME_SESSION_SECRET=dev-session-secret-32-bytes-min!!
LTP_TENANT_ACME_JWT_SECRET=dev-jwt-secret-32-bytes-min!!

# Controller runtime secrets:
DATABASE_DSN=postgres://ltp:ltp@localhost:5432/ltp?sslmode=disable
OIDC_SESSION_SECRET=global-dev-session-secret-32-bytes!

# Master key — mã hoá abt_ plaintext at rest (pkgs/secrets.Encrypt, sops.rs pattern)
# Sinh key mới: openssl rand -hex 32
LTP_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
